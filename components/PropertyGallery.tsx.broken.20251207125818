$path = ".\components\PropertyGallery.tsx"
$fixed = @'
"use client";
import React from "react";
import Image from "next/image";

type Props = { images?: string[] };

export default function PropertyGallery({ images = [] }: Props) {
  const first = images.length ? images[0] : "/properties/placeholder.jpg";

  return (
    <div className="space-y-3">
      {/* HERO IMAGE */}
      <div className="relative w-full h-[420px] rounded-2xl overflow-hidden shadow-lg">
        <Image
          src={first}
          alt="hero"
          fill
          priority
          sizes="100vw"
          style={{ objectFit: "cover" }}
        />
      </div>

      {/* THUMBNAILS */}
      <div className="grid grid-cols-5 gap-2">
        {images.slice(0, 5).map((src, i) => (
          <div key={i} className="relative w-full h-24 rounded-md overflow-hidden">
            <Image
              src={src}
              alt={"thumb-" + i}
              fill
              sizes="20vw"
              style={{ objectFit: "cover" }}
            />
          </div>
        ))}
      </div>
    </div>
  );
}
'@
Set-Content -LiteralPath $path -Value $fixed -Encoding utf8 -Force
Write-Host "✔ PropertyGallery.tsx FIXED and updated."
