"use client";
import React, { useEffect, useState } from "react";
import Image from "next/image";

type Props = { images?: string[] };

export default function PropertyGallery({ images = [] }: Props) {
  const [Slider, setSlider] = useState<any>(null);

  // Load heavy slider library AFTER page render (best performance)
  useEffect(() => {
    import("react-slick")
      .then((mod) => setSlider(() => mod.default))
      .catch(() => {});
  }, []);

  // If slider loaded → show carousel
  if (Slider) {
    const settings = {
      dots: true,
      infinite: true,
      speed: 400,
      slidesToShow: 1,
      slidesToScroll: 1,
    };

    return (
      // @ts-ignore
      <Slider {...settings}>
        {images.map((src, i) => (
          <div key={i} className="relative w-full h-[380px]">
            <Image
              src={src}
              alt={`image-${i}`}
              fill
              priority={i === 0}
              sizes="100vw"
              style={{ objectFit: "cover" }}
            />
          </div>
        ))}
      </Slider>
    );
  }

  // Fallback BEFORE slider loads
  return (
    <div className="relative w-full h-[380px]">
      {images[0] && (
        <Image
          src={images[0]}
          alt="fallback"
          fill
          priority
          sizes="100vw"
          style={{ objectFit: "cover" }}
        />
      )}
    </div>
  );
}
