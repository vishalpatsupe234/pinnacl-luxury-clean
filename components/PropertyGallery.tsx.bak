"use client";
import React, { useState } from "react";

type Props = { images?: string[] };

export default function PropertyGallery({ images = [] }: Props) {
  const [index, setIndex] = useState(0);
  if (!images || images.length === 0) images = ["/properties/placeholder.jpg"];

  const prev = () => setIndex((i) => (i - 1 + images.length) % images.length);
  const next = () => setIndex((i) => (i + 1) % images.length);

  return (
    <div className="property-gallery">
      <div className="relative">
        <img
          src={images[index]}
          alt={Image }
          className="w-full h-[520px] md:h-[460px] object-cover rounded-2xl"
          style={{ width: "100%", display: "block" }}
        />

        {images.length > 1 && (
          <>
            <button
              onClick={prev}
              aria-label="Previous"
              className="absolute left-4 top-1/2 -translate-y-1/2 bg-white/90 p-2 rounded-full shadow"
            >
              ‹
            </button>
            <button
              onClick={next}
              aria-label="Next"
              className="absolute right-4 top-1/2 -translate-y-1/2 bg-white/90 p-2 rounded-full shadow"
            >
              ›
            </button>
          </>
        )}
      </div>

      {images.length > 1 && (
        <div className="mt-3 flex gap-3 overflow-x-auto">
          {images.map((src, i) => (
            <button
              key={i}
              onClick={() => setIndex(i)}
              className={w-20 h-14 rounded-md overflow-hidden flex-shrink-0 border }
            >
              <img src={src} alt={	humb-} className="w-full h-full object-cover" />
            </button>
          ))}
        </div>
      )}
    </div>
  );
}
