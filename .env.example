# Example environment variables for local development
# Copy this file to .env.local and fill in your own secrets.

# Public site URL for canonical/Open Graph links
NEXT_PUBLIC_SITE_URL=https://pinnaclproperties.com

# Pinnacl's own MahaRERA real estate agent registration number.
# Not a secret — it is published on listings and in the footer.
# MahaRERA Order 46C/2025 records that Rule 14(2) of the Maharashtra RERA
# Rules 2017 requires a registered agent to quote the agent registration
# number and the project registration number in every advertisement.
# Leave unset and no agent disclosure renders at all — never a placeholder.
#
# This variable ALSO gates the public property surfaces. While it is unset,
# the site runs in pre-registration mode: /properties serves a holding
# notice, property detail pages 404, no property URLs appear in the sitemap,
# and the homepage shows no inventory. Setting the real issued number
# restores those surfaces — subject to the unchanged publication gates
# (approval_status = 'approved' AND deleted_at IS NULL).
NEXT_PUBLIC_MAHARERA_AGENT_REG_NO=

# Optional override. "true" forces pre-registration mode ON even after the
# registration number is configured. It can only tighten: setting "false"
# while no registration number exists is deliberately a no-op and will NOT
# open the public property surfaces. See lib/compliance/publicMode.ts.
NEXT_PUBLIC_PRE_REGISTRATION_PUBLIC_MODE=

# Google Sheets credentials for lead capture
GOOGLE_SHEET_ID=your_google_sheet_id_here
GOOGLE_SHEET_RANGE=Sheet1!A:G

# The Google service-account key, supplied as a value rather than a file.
# Replaces the former GOOGLE_SERVICE_ACCOUNT_KEY_PATH: a gitignored key file
# exists in no deployment, so the filesystem approach could never work on
# Vercel. Identical in local development and in production.
#
# Two encodings are accepted:
#   1. The raw JSON of the key file, single-quoted so the inner double
#      quotes survive dotenv parsing:
#        GOOGLE_SERVICE_ACCOUNT_JSON='{"type":"service_account",...}'
#   2. The same JSON, base64-encoded — recommended locally, since it is a
#      single line with no quoting pitfalls:
#        node -e "console.log(Buffer.from(require('fs').readFileSync('./google-service-account.json')).toString('base64'))"
#        GOOGLE_SERVICE_ACCOUNT_JSON=eyJ0eXBlIjoic2VydmljZV9hY2NvdW50Iiwi...
#
# In Vercel, paste either form as a single Production/Preview/Development
# variable. Never commit a real key — this file holds placeholders only.
GOOGLE_SERVICE_ACCOUNT_JSON=

# Resend email service settings
RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM_EMAIL=you@yourdomain.com
OWNER_NOTIFICATION_EMAIL=owner@yourdomain.com
