# Example environment variables for local development
# Copy this file to .env.local and fill in your own secrets.

# Public site URL for canonical/Open Graph links
NEXT_PUBLIC_SITE_URL=https://pinnaclproperties.com

# Google Sheets credentials for lead capture
GOOGLE_SHEET_ID=your_google_sheet_id_here
GOOGLE_SHEET_RANGE=Sheet1!A:G
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=./google-service-account.json

# Resend email service settings
RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM_EMAIL=you@yourdomain.com
OWNER_NOTIFICATION_EMAIL=owner@yourdomain.com
