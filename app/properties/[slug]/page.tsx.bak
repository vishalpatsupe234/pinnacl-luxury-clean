import React from "react";
import Link from "next/link";
import PropertyGallery from "../../../components/PropertyGallery";

type Props = { params: { slug?: string } };

export default async function PropertyPage({ params }: Props) {
  \ \ //\ params\ may\ be\ a\ plain\ object\ or\ a\ Promise\ \(app-router\ nuance\)\.\n\ \ //\ If\ it's\ a\ Promise\ we\ await\ it;\ otherwise\ use\ directly\.\n\ \ const\ resolvedParams\ =\ \(params\ as\ any\)\?\.then\ \?\ await\ \(params\ as\ any\)\ :\ params;\n\ \ const\ slug\ =\ resolvedParams\?\.slug;
  let raw = "";
  let prop = null;

  try {
    const res = await fetch("http://localhost:3000/api/properties?slug=" + slug, { cache: "no-store" });
    raw = await res.clone().text();

    if (res.ok) {
      const data = await res.json();

      if (data?.items) prop = data.items.find(p => p.slug === slug) || data.items[0];
      else if (Array.isArray(data)) prop = data.find(p => p.slug === slug) || data[0];
      else if (data?.slug) prop = data;
    }
  } catch (err) {
    console.error("API ERROR:", err);
  }

  if (!prop) {
    return (
      <div className="p-8 max-w-4xl mx-auto">
        <h1 className="text-xl font-semibold">Property Not Found</h1>
        <pre className="text-xs mt-4 whitespace-pre-wrap">{raw}</pre>
      </div>
    );
  }

  return (
    <div className="px-6 md:px-12 py-8 max-w-7xl mx-auto">
      <div className="mb-6">
        <Link href="/properties" className="text-sm text-neutral-600 hover:text-black">← Back</Link>
      </div>

      <div className="grid grid-cols-1 lg:grid-cols-3 gap-8">
        <div className="lg:col-span-2">
          <PropertyGallery images={prop.images ?? []} />
        </div>

        <aside className="lg:col-span-1">
          <div className="p-6 rounded-2xl border bg-white shadow-sm sticky top-24">
            <h1 className="text-2xl font-semibold">{prop.title}</h1>
            <p className="text-sm text-neutral-600">{prop.location?.area}, {prop.location?.city}</p>

            <div className="mt-4">
              <div className="text-sm text-neutral-500">Price</div>
              <div className="text-xl font-semibold">{prop.priceDisplay}</div>
            </div>

            <div className="mt-4">
              <div className="text-sm text-neutral-500">Area</div>
              <div className="text-base">{prop.areaText}</div>
            </div>

            {prop.highlights?.length > 0 && (
              <ul className="mt-4 space-y-1 text-sm">
                {prop.highlights.map((h, i) => (
                  <li key={i} className="flex items-center gap-2">
                    <span className="w-2 h-2 bg-[var(--color-brand-gold)] rounded-full" />
                    {h}
                  </li>
                ))}
              </ul>
            )}
          </div>
        </aside>
      </div>

      <details className="mt-8 text-sm text-neutral-600">
        <summary>Debug API response</summary>
        <pre className="text-xs mt-2 whitespace-pre-wrap">{raw}</pre>
      </details>
    </div>
  );
}

