import fs from "fs/promises";
import path from "path";

type PropertyItem = { id?: string; slug?: string; [key: string]: any };

const CACHE_TTL_MS = 5 * 60 * 1000; // 5 minutes

let cache: { ts: number; data: PropertyItem[] | null } | null = null;
let initialLoadError: string | null = null;

async function readDataFile(): Promise<PropertyItem[]> {
  const now = Date.now();
  if (cache && (now - cache.ts) < CACHE_TTL_MS && cache.data) {
    return cache.data;
  }

  const file = path.join(process.cwd(), "data", "properties.json");
  const raw = await fs.readFile(file, "utf8");
  const obj = JSON.parse(raw);
  const items = Array.isArray(obj.items) ? obj.items : (obj as any);
  cache = { ts: now, data: items };
  return items;
}

// optional: attempt initial load so first request isn't slow
(async () => {
  try {
    await readDataFile();
  } catch (e: any) {
    initialLoadError = String(e?.message || e);
    console.warn("Initial properties.json load failed:", initialLoadError);
  }
})();

export async function GET(req: Request) {
  const t0 = Date.now();
  let readMs = 0, filterMs = 0, extMs = 0;

  try {
    const tA = Date.now();
    const items = await readDataFile();
    readMs = Date.now() - tA;

    const tB = Date.now();
    const url = new URL(req.url);
    const slug = url.searchParams.get("slug");
    let result: PropertyItem | null = null;

    if (slug) {
      result = items.find(i => i && (i.slug === slug || i.id === slug)) ?? null;
    }
    filterMs = Date.now() - tB;

    // placeholder external timing
    const tC = Date.now();
    extMs = Date.now() - tC;

    const total = Date.now() - t0;
    console.log(`API timings: total=${total}ms read=${readMs}ms filter=${filterMs}ms external=${extMs}ms cacheAge=${cache?.ts ? (Date.now()-cache.ts) : "nocache"}ms`);

    const body = slug ? (result ? result : {}) : items;
    const res = new Response(JSON.stringify(body), { status: 200 });
    // recommended cache-control so browsers/proxies can cache for short TTL
    res.headers.set("content-type", "application/json");
    res.headers.set("cache-control", "public, max-age=60, stale-while-revalidate=30");
    return res;
  } catch (err) {
    const total = Date.now() - t0;
    console.error("API error:", err);
    console.log(`API timings (error): total=${total}ms read=${readMs}ms filter=${filterMs}ms external=${extMs}ms`);
    return new Response(JSON.stringify({ error: String(err) }), { status: 500, headers: { "content-type": "application/json" }});
  }
}
